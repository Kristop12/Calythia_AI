LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Pin the chat model id that is ALREADY loaded in LM Studio (recommended for MCP).
# If empty, Calythia only uses a model that LM Studio reports as loaded — it will
# not pick an unloaded library model (which would trigger a second load).
# For reliable tool calling, prefer a coder/tool-use model (e.g. Qwen3-Coder).
LM_STUDIO_MODEL=
# Optional: Whisper / STT model id for mic input (POST /v1/audio/transcriptions).
LM_STUDIO_WHISPER_MODEL=

# --- MCP (LM Studio 0.4+) — fallback when native tools off or Agent mode PC ---
# Uses POST /api/v1/chat with integrations from ~/.lmstudio/mcp.json
# Required in LM Studio → Developer → Server Settings:
#   1) Require Authentication
#   2) Allow calling servers from mcp.json
# Then create a token and paste it here:
LM_STUDIO_API_TOKEN=
# Set to 0 to skip MCP and use plain /v1/chat/completions
LM_STUDIO_MCP=1
# Optional: override which mcp.json servers to enable (comma-separated labels)
# LM_STUDIO_MCP_SERVERS=open-interpreter,personal-pc
# Optional: path to mcp.json (default ~/.lmstudio/mcp.json)
# LM_STUDIO_MCP_JSON=
# Optional: larger context helps tool-heavy turns
# LM_STUDIO_CONTEXT_LENGTH=8192

# --- Native Jarvis tools (Calythia-owned execution loop) ---
# Set to 0 to disable native tools and rely on MCP only
CALYTHIA_NATIVE_TOOLS=1
# Allowed paths for read_file / list_directory (comma-separated)
# CALYTHIA_ALLOWED_PATHS=/Users/you/Documents,/Users/you/Downloads
# Open Interpreter binary (Rust CLI from openinterpreter.com/install)
# CALYTHIA_INTERPRETER_PATH=/Users/you/.local/bin/interpreter
# CALYTHIA_OI_TIMEOUT_MS=300000
# yt-dlp for YouTube metadata (install: brew install yt-dlp)
# YT_DLP_PATH=yt-dlp
# Browser Use Python venv (Python 3.12+)
# BROWSER_USE_VENV=/Users/you/.venvs/browser-use
# CALYTHIA_BROWSER_TIMEOUT_MS=180000

# --- xAI Grok (optional cloud brain) ---
# Get a key at https://console.x.ai — never commit this value.
XAI_API_KEY=
# Default Grok model when UI has none selected
XAI_MODEL=grok-4.6
# Optional override (default https://api.x.ai/v1)
# XAI_BASE_URL=https://api.x.ai/v1

# --- Kokoro TTS (browser) — one ONNX load per session ---
# Prefers webgpu/fp32; automatically retries wasm/q8 if WebGPU fails.
# NEXT_PUBLIC_KOKORO_DEVICE=webgpu
# NEXT_PUBLIC_KOKORO_DTYPE=fp32
# Allow system Web Speech after Kokoro fails (default 1). Set 0 for hard errors only.
# NEXT_PUBLIC_KOKORO_FALLBACK=1
